# Engine Environment Variables
# Copy to .env and fill in values

# Application
VERSION=0.1.0

# CORS - allowed origins (JSON array format, or comma-separated)
# JSON array format (preferred):
# ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Comma-separated format (also supported):
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase (for future slices)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# LLM Provider (for future slices)
# Set at the provider spike (REVIEW_ENGINE.md section 3)
LLM_PROVIDER=fake
LLM_MODEL=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Rate limiting (for future slices)
# DAILY_REVIEW_CAP=20