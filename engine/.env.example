# Engine Environment Variables
# Copy to .env and fill in values

# Application
VERSION=0.1.0

# Runtime environment: development, staging, or production.
# Local development only:
ENVIRONMENT=development

# CORS - allowed origins (JSON array format, or comma-separated)
# JSON array format (preferred):
# ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Comma-separated format (also supported):
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Review preview encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Keep this key private and identical across all engine instances. Never commit a real key.
PREVIEW_ENCRYPTION_KEY=

# Supabase (for future slices)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# LLM Provider (for future slices)
# Set at the provider spike (REVIEW_ENGINE.md section 3)
LLM_PROVIDER=fake
LLM_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_TPM_LIMIT=8000

# Rate limiting (for future slices)
# DAILY_REVIEW_CAP=20