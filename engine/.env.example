# AnchorDraft Engine environment
# Copy to .env and replace placeholders with values from your local Supabase stack.
# Never commit .env or real credentials.

# Runtime
VERSION=0.1.0
ENVIRONMENT=development

# Browser origins; JSON array or comma-separated values are accepted.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL direct connection used by asyncpg.
# Local Supabase default; confirm with: supabase status
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres

# Supabase project/API and server-side service client.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY

# Supabase JWT verification. For local Supabase these normally match the local API URL.
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_AUDIENCE=authenticated

# Confidentiality review-preview encryption.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PREVIEW_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Local/test only: fake provider is permitted in development/test.
# Staging/production must use a real provider and valid credentials.
LLM_PROVIDER=fake
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_ENABLED=false

# Groq (used when LLM_PROVIDER or fallback provider is groq).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TPM_LIMIT=8000
GROQ_RPM_LIMIT=30

# Gemini (used when LLM_PROVIDER or fallback provider is gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TPM_LIMIT=250000
GEMINI_RPM_LIMIT=15

# Request/review limits (application defaults shown).
DAILY_REVIEW_CAP=20
PER_USER_RATE_LIMIT=10
REVISION_BODY_MAX_CHARS=20000
COMMENT_MAX_CHARS=2000
UPLOAD_MAX_MB=5
UPLOAD_MAX_PAGES=20
REQUEST_BODY_MAX_MB=6
