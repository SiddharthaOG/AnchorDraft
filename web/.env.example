# AnchorDraft Web environment
# Copy to .env and replace placeholders with local/hosted project values.
# Only the public Supabase anon/publishable key belongs in the browser.
# NEVER put a service-role key or LLM provider key in a VITE_ variable.

VITE_ENGINE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY
